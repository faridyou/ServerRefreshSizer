<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t('c_title') }} - {{ project.name }}</title>
{% include "_style.html.j2" %}
</head>
<body>
{% if pdf %}<h1>{{ t('c_title') }}</h1><p>{{ project.name }} - {{ run.generated_at[:10] }}</p>
{% else %}<header><div class="inner"><h1>{{ t('c_title') }}</h1><div>{{ project.name }} · {{ run.generated_at[:10] }}</div></div></header>{% endif %}
<main>
<p class="lead">{{ t('c_intro') }}</p>

{% for c in clusters %}{% set d = c.d %}{% set r = c.rec %}{% set s = c.src %}
<h2>{{ d.cluster }}</h2>
{% if c.src.sources %}<p class="muted">{{ t('consolidated_from') | replace('{n}', c.src.sources | length | string) }}: {{ c.src.sources | join(', ') }}</p>{% endif %}
{% if c.banner %}<p class="{{ 'banner' if c.banner == 'very_low_banner' else 'lowbanner' }}">{{ t(c.banner) }}</p>{% endif %}

<section class="card">
<h3>1. {{ t('c_current') }}</h3>
<table>
<tr><th>{{ t('cpu') }}</th><th class="num">{{ t('hosts') }}</th><th class="num">{{ t('c_sockets') }}</th><th class="num">{{ t('cores') }}</th><th class="num">GHz</th></tr>
{% for m in s.models %}<tr><td>{{ m.cpu }}</td><td class="num">{{ m.hosts }}</td><td class="num">{{ m.sockets or '' }}</td><td class="num">{{ m.cores }}</td><td class="num">{{ m.ghz | fmt }}</td></tr>{% endfor %}
<tr><th>{{ t('ui_overall') }}</th><th class="num">{{ s.hosts }}</th><th class="num">{{ s.sockets }}</th><th class="num">{{ s.cores }}</th><th class="num">{{ s.ghz_total | fmt }} GHz {{ t('c_total') }}</th></tr>
</table>
<table>
<tr><td>{{ t('memory') }}</td><td class="num">{{ s.ram_gb | fmt }} GB</td><td>{{ t('c_vms') }}</td><td class="num">{{ s.vms }} ({{ s.vcpu | fmt }} vCPU)</td></tr>
<tr><td>{{ t('c_storage_used') }}</td><td class="num">{{ s.storage_used_tib | fmt }} TiB</td><td>{{ t('c_cpu_util') }}</td><td class="num">{% if s.util_pct is not none %}{{ s.util_pct }} % ({{ s.util_basis }}){% else %}{{ t('c_no_util') }}{% endif %}</td></tr>
</table>
{% if s.collection_days %}<p class="muted">{{ t('c_collection') }}: {{ s.collection_days | fmt }} {{ t('c_days') }}.</p>{% endif %}
</section>

<section class="card">
<h3>2. {{ t('c_benchmarks') }}</h3>
<p>{{ t('c_bench_intro') }}</p>
<table><tr><th></th><th>{{ t('cpu') }}</th><th class="num">SPECrate2017_int_base</th><th class="num">{{ t('c_per_core') }}</th><th>{{ t('system') }}</th><th>{{ t('sources') }}</th></tr>
{% for b in c.benchmarks if b.metric != 'rPerf' %}<tr><td>{{ t('c_side_' ~ b.side) }}</td><td>{{ b.cpu }}</td><td class="num">{{ b.value | fmt }}</td><td class="num">{{ b.spc }}</td><td>{{ b.system }}</td><td class="muted">{{ b.url }}</td></tr>{% endfor %}
</table>
{% if s.perf_ratio %}<p class="note">{{ t('c_perf_ratio') | replace('{x}', s.perf_ratio | string) }}</p>{% endif %}
</section>

{% if r %}
<section class="card">
<h3>3. {{ t('c_result') }}</h3>
<div class="kpis">
<div class="kpi"><div class="v">{{ r.n_total }}</div><div class="l">{{ t('c_servers') }} PowerEdge {{ r.config.platform }}</div></div>
<div class="kpi"><div class="v">{{ r.n_total * r.config.cpu_count * r.config.cores_per_cpu }}</div><div class="l">{{ t('cores') }} ({{ t('c_vs') }} {{ s.cores }})</div></div>
<div class="kpi"><div class="v">{{ r.util_failed | pct }}</div><div class="l">{{ t('c_util_after_failure') }}</div></div>
</div>
<table>
<tr><td>{{ t('c_per_server') }}</td><td>{{ r.config.cpu_count }} x {{ r.config.cpu_name }} ({{ r.config.cores_per_cpu }} {{ t('cores') | lower }})</td></tr>
<tr><td>{{ t('memory') }}</td><td>{% if r.dimm %}{{ r.dimm.total_gb }} GB ({{ r.dimm.dimm_count }} x {{ r.dimm.dimm_size_gb }} GB){% endif %}</td></tr>
<tr><td>{{ t('drives') }}</td><td>{% if r.drives %}{{ r.drives.count }} x {{ r.drives.drive_tb }} TB NVMe{% else %}{{ t('c_external') }}{% endif %}</td></tr>
<tr><td>{{ t('network') }}</td><td>{{ r.nics }}</td></tr>
<tr><td>{{ t('c_platform') }}</td><td>{{ c.cs.target_selection.split(';')[0] }}</td></tr>
{% if policy.target_stack and policy.target_stack != 'vmware_vsan' %}<tr><td>{{ t('cvm_row') }}</td><td>{{ policy.nutanix_cvm_vcpu }} vCPU / {{ policy.nutanix_cvm_memory_gb }} GB</td></tr>{% endif %}
</table>
<p>{{ t('c_assumptions') | replace('{g}', d.growth_cpu_pct | fmt) | replace('{y}', d.years | string) | replace('{u}', (d.u_max * 100) | round | int | string) | replace('{k}', r.k_ha | string) }}</p>
{% if c.charts.hosts %}<img class="chart" src="{{ c.charts.hosts }}" alt="{{ t('c_chart_title') }}">{% endif %}
<p class="muted">{{ t('c_naive_note') }}</p>
</section>

{% set st_heading = '4. ' ~ t('st_title') %}{% include "_storage.html.j2" %}
{% if c.cs.scenarios | length > 1 %}
<section class="card">
<h3>5. {{ t('c_alternatives') }}</h3>
<table><tr><th>{{ t('cpu') }}</th><th>{{ t('c_platform') }}</th><th class="num">{{ t('c_servers') | capitalize }}</th><th class="num">{{ t('cores') }}</th><th class="num">{{ t('c_util_after_failure') }}</th><th class="num">{{ t('power') }}</th><th></th></tr>
{% for x in c.cs.scenarios[:8] %}<tr><td>{{ x.config.cpu_count }} x {{ x.config.cpu_name }}</td><td>PowerEdge {{ x.config.platform }}</td><td class="num">{{ x.n_total }}</td><td class="num">{{ x.n_total * x.config.cpu_count * x.config.cores_per_cpu }}</td><td class="num">{{ x.util_failed | pct }}</td><td class="num">{{ '{:,.0f}'.format(x.power_w_total) }} W</td><td>{{ c.scenario_tags.get(x.label, []) | join(', ') }}</td></tr>{% endfor %}
</table></section>
{% endif %}
{% endif %}
{% endfor %}

<h2>{{ t('c_next') }}</h2>
<section class="card">
<ol>{% if clusters | selectattr('banner') | list %}<li>{{ t('c_next_measure') }}</li>{% endif %}
<li>{{ t('c_next_pilot') }}</li><li>{{ t('c_next_info') }}</li><li>{{ t('c_next_quote') }}</li></ol>
{% if questions %}<h3>{{ t('c_questions') }}</h3><ol>{% for q in questions %}<li>{{ q }}</li>{% endfor %}</ol>{% endif %}
</section>
<p class="muted small">{{ t('c_disclaimer') }}</p>
</main>
</body>
</html>
