{# Storage design section (all levels); expects c (cluster context) and an optional heading prefix #}
{% set st = c.storage %}{% if st %}
<section class="card">
<h3>{{ st_heading | default(st.title) }}</h3>
{% for f in st.flags %}<p class="lowbanner">{{ f }}</p>{% endfor %}
{% for title, rows in st.groups %}
<h4>{{ title }}</h4>
<table class="small kv">{% for k, v in rows %}<tr><td>{{ k }}</td><td>{{ v }}</td></tr>{% endfor %}</table>
{% endfor %}
{% if st.alternatives %}<h4>{{ t('st_alternatives') }}</h4>
<table class="small"><tr>{% for h in st.alternatives.header %}<th{% if st.alternatives.align[loop.index0] == 'r' %} class="num"{% endif %}>{{ h }}</th>{% endfor %}</tr>
{% for row in st.alternatives.rows %}<tr{% if loop.first %} class="rec"{% endif %}>{% for v in row %}<td{% if st.alternatives.align[loop.index0] == 'r' %} class="num"{% endif %}>{{ v }}</td>{% endfor %}</tr>{% endfor %}
</table>{% endif %}
{% if st.explanations %}<h4>{{ t('formula') }}</h4><ul class="small">{% for e in st.explanations %}<li><b>{{ e.title }}</b>: {{ e.formula_text }}</li>{% endfor %}</ul>{% endif %}
{% if st.notes %}<ul class="small muted">{% for n in st.notes %}<li>{{ n }}</li>{% endfor %}</ul>{% endif %}
</section>
{% endif %}
