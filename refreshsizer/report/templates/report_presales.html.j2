<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t('p_title') }} - {{ project.name }}</title>
{% include "_style.html.j2" %}
</head>
<body>
{% if pdf %}<h1>{{ t('p_title') }}</h1><p>{{ project.name }} - {{ run.generated_at }} - RefreshSizer {{ version }}</p>
{% else %}<header><div class="inner"><h1>{{ t('p_title') }}</h1><div>{{ project.name }} · {{ run.generated_at }} · RefreshSizer {{ version }}</div></div></header>{% endif %}
<main>

<h2>{{ t('s1') }}</h2>
<section class="card">
<table><tr><th>{{ t('cluster') }}</th><th>{{ t('mode') }} / {{ t('confidence') }}</th><th>{{ t('recommended') }}</th><th class="num">{{ t('hosts') }}</th><th class="num">P90</th><th class="num">{{ t('util_failed') }}</th><th class="num">{{ t('core_match') }} / GHz</th><th class="num">{{ t('licensing_delta') }}</th><th class="num">TCO</th></tr>
{% for c in clusters %}{% set r = c.rec %}<tr><td>{{ c.d.cluster }}</td><td>{{ c.d.mode.value }} / {{ c.d.confidence.value }}</td><td>{{ r.label if r else '-' }}</td><td class="num"><b>{{ r.n_total if r else '-' }}</b></td>
<td class="num">{{ c.cs.uncertainty.p90_hosts if c.cs.uncertainty else '-' }}</td><td class="num">{{ r.util_failed | pct if r else '-' }}</td>
<td class="num">{{ c.cs.naive.core_match_hosts if c.cs.naive else '-' }} / {{ c.cs.naive.ghz_match_hosts if c.cs.naive else '-' }}</td>
<td class="num">{{ c.license_delta | money if c.license_delta is not none else '-' }}</td><td class="num">{{ r.tco | money if r else '-' }}</td></tr>{% endfor %}
</table>
<p class="muted">{{ t('ui_target_used') }}: {{ clusters[0].cs.target_selection if clusters else '' }} · {{ t('p_prices_note') }}</p>
{% for c in clusters %}{% if c.banner %}<p class="{{ 'banner' if c.banner == 'very_low_banner' else 'lowbanner' }}">{{ c.d.cluster }}: {{ t(c.banner) }}</p>{% endif %}{% endfor %}
</section>

{% for c in clusters %}{% set d = c.d %}{% set r = c.rec %}{% set s = c.src %}
<h2>{{ d.cluster }}</h2>
{% if c.src.sources %}<p class="muted">{{ t('consolidated_from') | replace('{n}', c.src.sources | length | string) }}: {{ c.src.sources | join(', ') }}</p>{% endif %}
<section class="card">
<h3>{{ t('p_source') }}</h3>
<p>{{ s.hosts }} {{ t('hosts') | lower }}, {{ s.cores }} {{ t('cores') | lower }} ({{ s.ghz_total | fmt }} GHz), {{ s.ram_gb | fmt }} GB RAM, {{ s.vms }} VMs / {{ s.vcpu | fmt }} vCPU, {{ s.storage_used_tib | fmt }} TiB {{ t('c_storage_used') | lower }}.
{% if s.util_pct is not none %}{{ t('c_cpu_util') }}: {{ s.util_pct }} % ({{ s.util_basis }}).{% endif %}
{% if s.collection_days %}{{ t('c_collection') }}: {{ s.collection_days | fmt }} {{ t('c_days') }}.{% endif %}</p>
<table class="small"><tr><th>{{ t('cpu') }}</th><th class="num">{{ t('hosts') }}</th><th class="num">{{ t('cores') }}</th><th class="num">GHz</th><th class="num">SPC</th><th>{{ t('sources') }}</th></tr>
{% for m in s.models %}{% set b = (c.benchmarks | selectattr('side', 'equalto', 'source') | first) %}<tr><td>{{ m.cpu }}</td><td class="num">{{ m.hosts }}</td><td class="num">{{ m.cores }}</td><td class="num">{{ m.ghz | fmt }}</td><td class="num">{{ d.spc_source | fmt }}</td><td class="muted">{{ b.system ~ ' - ' ~ b.url if b else '' }}</td></tr>{% endfor %}
</table>
</section>

<section class="card">
<h3>{{ t('p_chain') }}</h3>
<p class="small muted">{{ t('unit_def') }}</p>
<table>
{% set steps = [
  (t('p_step_cap'), d.su_cap_total | fmt ~ ' ' ~ t('unit'), s.cores ~ ' cores x SPC ' ~ (d.spc_source | fmt)),
  (t('p_step_d0'), d.d0 | fmt ~ ' ' ~ t('unit'), d.mode.value ~ (', ' ~ s.util_basis if s.util_basis else '')),
  (t('p_step_adj'), d.d0_adj | fmt ~ ' ' ~ t('unit'), 'k_arch ' ~ (d.k_arch | fmt) ~ ', k_virt ' ~ (d.k_virt | fmt)),
  (t('p_step_growth'), d.d_t | fmt ~ ' ' ~ t('unit'), (d.growth_cpu_pct | fmt) ~ ' %/yr x ' ~ d.years ~ ' yr'),
  (t('p_step_headroom'), d.c_req | fmt ~ ' ' ~ t('unit'), 'U_max ' ~ (d.u_max | pct)),
] %}
{% for label, val, how in steps %}<tr><td>{{ label }}</td><td class="num"><b>{{ val }}</b></td><td class="muted">{{ how }}</td></tr>{% endfor %}
{% if r %}<tr><td>{{ t('p_step_host') }}</td><td class="num"><b>{{ r.su_host_effective | fmt }} {{ t('unit') }}</b></td><td class="muted">{{ r.config.cpu_count }} x {{ r.config.cpu_name }}, SPC {{ r.spc_target | fmt }}{% if r.su_host_effective < r.su_host %} ({{ t('p_after_reserve') }} {{ r.su_host | fmt }}){% endif %}</td></tr>
<tr><td>{{ t('p_step_hosts') }}</td><td class="num"><b>{{ r.n_total }}</b></td><td class="muted">{{ r.n_total - r.k_ha }} + {{ r.k_ha }} HA; {{ r.n_min_reason }}</td></tr>{% endif %}
<tr><td>{{ t('memory') }}</td><td class="num"><b>{{ d.m_t | fmt }} GB</b></td><td class="muted">{{ d.mem_basis }} {{ d.m0 | fmt }} GB, +{{ d.growth_mem_pct | fmt }} %/yr</td></tr>
<tr><td>{{ t('p_step_storage') }}</td><td class="num"><b>{{ d.storage_raw_tib | fmt }} TiB raw</b></td><td class="muted">{{ d.storage_used0_tib | fmt }} TiB used, +{{ d.growth_storage_pct | fmt }} %/yr, {{ d.protection }}</td></tr>
</table>
</section>

{% if r %}
<section class="card">
<h3>{{ t('s8') }}</h3>
<table class="small">
<tr><td>Platform</td><td>Dell PowerEdge {{ r.config.platform }} x {{ r.n_total }}</td></tr>
<tr><td>{{ t('cpu') }}</td><td>{{ r.config.cpu_count }} x {{ r.config.cpu_name }} ({{ r.config.cores_per_cpu }} c, {{ c.cpu.base_ghz }} GHz)</td></tr>
<tr><td>{{ t('memory') }}</td><td>{% if r.dimm %}{{ r.dimm.dimm_count }} x {{ r.dimm.dimm_size_gb }} GB = {{ r.dimm.total_gb }} GB, {{ r.dimm.dpc }} DPC @ {{ r.dimm.speed_mt_s }} MT/s{% endif %}</td></tr>
<tr><td>{{ t('drives') }}</td><td>{% if r.drives %}{{ r.drives.count }} x {{ r.drives.drive_tb }} TB NVMe ({{ r.drives.raw_tib }} TiB){% else %}external{% endif %}</td></tr>
<tr><td>{{ t('network') }}</td><td>{{ r.nics }}</td></tr>
{% if policy.target_stack and policy.target_stack != 'vmware_vsan' %}<tr><td>{{ t('cvm_row') }}</td><td>{{ policy.nutanix_cvm_vcpu }} vCPU / {{ policy.nutanix_cvm_memory_gb }} GB · {{ d.protection }}</td></tr>{% endif %}
</table>
{% if c.dimm_diagram %}<pre class="dimm">{% for l in c.dimm_diagram %}{{ l }}
{% endfor %}</pre>{% endif %}
</section>

{% include "_storage.html.j2" %}
{% if c.cs.scenarios %}
<section class="card"><h3>{{ t('ui_scenarios') }}</h3>
<table class="small"><tr><th>{{ t('cpu') }} / platform</th><th>{{ t('ui_spec_basis') }}</th><th class="num">{{ t('hosts') }}</th><th class="num">{{ t('cores') }}</th><th class="num">{{ t('util_failed') }}</th><th class="num">TCO</th><th class="num">{{ t('ui_vs_rec') }}</th><th></th></tr>
{% for x in c.cs.scenarios[:10] %}<tr><td>{{ x.label }}</td><td>{{ c.scenario_basis[x.label] }}</td><td class="num">{{ x.n_total }}</td><td class="num">{{ x.n_total * x.config.cpu_count * x.config.cores_per_cpu }}</td><td class="num">{{ x.util_failed | pct }}</td><td class="num">{{ x.tco | money }}</td><td class="num">{{ (x.tco - r.tco) | money }}</td><td>{{ c.scenario_tags.get(x.label, []) | join(', ') }}</td></tr>{% endfor %}
</table></section>
{% endif %}

<section class="card"><h3>{{ t('s10') }}</h3>
<table class="small"><tr><th>{{ t('product') }}</th><th class="num">{{ t('quantity') }}</th><th class="num">{{ t('p_horizon_cost') }}</th></tr>
{% for l in r.licenses %}<tr><td>{{ l.product }}</td><td class="num">{{ l.quantity | fmt }} {{ l.metric }}</td><td class="num">{{ l.horizon_usd | money }}</td></tr>{% endfor %}
<tr><th>{{ t('source_side') }}</th><th></th><th class="num">{{ c.src_license_total | money }}</th></tr>
<tr><th>{{ t('licensing_delta') }}</th><th></th><th class="num">{{ c.license_delta | money }}</th></tr></table>
{% if r.oracle_licenses_all %}<p>Oracle: {{ r.oracle_licenses_active | fmt }} (active nodes) / {{ r.oracle_licenses_all | fmt }} (all nodes).</p>{% endif %}
</section>

{% set issues = c.constraints | rejectattr('status', 'equalto', 'OK') | list %}
<section class="card"><h3>{{ t('p_checks') }}</h3>
{% if issues %}<ul>{% for k in issues %}<li><span class="tag {{ k.status }}">{{ k.status }}</span> {{ k.check }}: {{ k.detail }}</li>{% endfor %}</ul>
{% else %}<p class="ok-cell">{{ t('p_all_ok') }} ({{ c.constraints | length }})</p>{% endif %}
{% if c.cs.uncertainty %}<p>Monte Carlo ({{ c.cs.uncertainty.runs }} runs): P50 <b>{{ c.cs.uncertainty.p50_hosts }}</b> / P90 <b>{{ c.cs.uncertainty.p90_hosts }}</b> {{ t('hosts') | lower }}.</p>{% endif %}
{% if d.inventory_sensitivity %}<p>{{ t('sensitivity') }}: {% for x in d.inventory_sensitivity %}{{ x.assumed_util | pct }} -> {{ x.hosts }}{{ ', ' if not loop.last }}{% endfor %} {{ t('hosts') | lower }}.</p>{% endif %}
</section>
{% endif %}
{% endfor %}

<h2>{{ t('p_quality') }}</h2>
<section class="card">
<ul>{% for c in clusters %}{% for f in c.d.flags[:6] %}<li>[{{ c.d.cluster }}] {{ f }}</li>{% endfor %}{% endfor %}
{% for w in (project.ingest.warnings + project.ingest.conflicts)[:8] %}<li>{{ w }}</li>{% endfor %}</ul>
{% if (project.ingest.warnings | length) > 8 %}<p class="muted">{{ (project.ingest.warnings | length) - 8 }} {{ t('p_more_in_full') }}</p>{% endif %}
<h3>{{ t('questions') }}</h3><ol>{% for q in questions %}<li>{{ q }}</li>{% endfor %}</ol>
<h3>{{ t('s13') }}</h3><ol>{% for x in (clusters[0].cs.recommendations if clusters else []) %}<li>{{ x }}</li>{% endfor %}</ol>
</section>
<p class="muted small">{{ run.disclaimers | join(' ') }}</p>
</main>
</body>
</html>
